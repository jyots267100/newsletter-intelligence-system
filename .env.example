# ============================================================================
# Newsletter Intelligence System - Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Gemini LLM -------------------------------------------------------------
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model name is configurable because Google periodically retires free-tier
# models. Check https://ai.google.dev/gemini-api/docs/models for the current
# list before relying on the default below.
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings ---------------------------------------------------------
# Any sentence-transformers model works. all-MiniLM-L6-v2 is small, fast,
# and runs on CPU with no GPU required - good enough for newsletter-length
# documents and free to run locally (no API calls, no cost).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage ------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./chroma_data
BM25_INDEX_PATH=./chroma_data/bm25_index.pkl
DOCUMENT_REGISTRY_PATH=./chroma_data/documents.json

# --- Chunking -------------------------------------------------------------
# 1000 characters (~200-250 tokens) balances enough context per chunk
# against retrieval precision; 150 char overlap keeps sentences that
# straddle a chunk boundary from losing context. See docs/architecture.md.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ------------------------------------------------------------
RETRIEVAL_TOP_K=5
# Candidates considered by each retriever (vector/BM25) before fusion.
RETRIEVAL_CANDIDATE_K=20
# Broader top_k used for whole-document analysis (summary/insights/actions).
ANALYSIS_TOP_K=15
# Reciprocal Rank Fusion constant. 60 is the value used in the original
# RRF paper (Cormack et al., 2009) and is a reasonable default.
RRF_K=60

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20

# --- App --------------------------------------------------------------
LOG_LEVEL=INFO
APP_ENV=development

# Bounded conversation memory: number of past turns kept for follow-up
# question rewriting (not resent as "evidence").
CHAT_HISTORY_TURNS=6

# Bounded retries for transient Gemini failures (timeouts, 429, 5xx).
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30
